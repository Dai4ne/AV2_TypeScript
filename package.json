{
  "name": "greencode-av2",
  "version": "1.0.0",
  "private": true,
  "description": "API do sistema GreenCode para a AV2",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test:api": "tsx --test tests/api.integration.test.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.5",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/client": "6.19.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
