# Copie para .env e informe os dados do seu PostgreSQL local.
DATABASE_URL="postgresql://postgres:senha_local@localhost:5432/greencode?schema=public"
# Troque por uma chave aleatória longa antes de executar a API.
JWT_SECRET="troque-esta-chave-por-uma-chave-local-com-mais-de-32-caracteres"
HOST="127.0.0.1"
PORT="3000"
# Credenciais usadas somente para criar o primeiro administrador.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-segura
