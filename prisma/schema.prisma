generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTAGEM
  EM_DESMONTAGEM
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

model Usuario {
  id           String       @id @default(uuid())
  usuario      String       @unique
  hashSenha    String
  salt         String
  ultimoAcesso DateTime?
  papel        PapelUsuario
  criadoEm     DateTime     @default(now())
  ativo        Boolean      @default(true)
}

model Organizacao {
  id                String    @id
  razaoSocial       String
  cnpj              String    @unique
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  dataCadastro      DateTime  @default(now())
  ativo             Boolean   @default(true)
  contrato          Contrato?
  lotes             Lote[]
}

model Contrato {
  id                  String      @id @default(uuid())
  organizacaoId       String      @unique
  dataAssinatura      DateTime
  dataVencimento      DateTime
  clausulas           Json        @db.JsonB
  valorMensal         Decimal     @db.Decimal(12, 2)
  renovacaoAutomatica Boolean     @default(false)
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
}

model Lote {
  id                  String       @id
  dataEntrada         DateTime
  organizacaoId       String
  notaFiscal          String
  transportadora      String
  statusProcessamento StatusLote   @default(RECEBIDO)
  observacoes         String       @default("")
  ativo               Boolean      @default(true)
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  equipamentos        Equipamento[]

  @@index([organizacaoId])
  @@index([dataEntrada])
}

model Equipamento {
  id                  String             @id
  codigoBarrasInterno String             @unique
  tipo                TipoEquipamento
  marca               String
  modelo              String
  anoFabricacao       Int
  estadoFisico        EstadoFisico
  pesoQuilogramas     Decimal            @db.Decimal(10, 3)
  loteId              String
  posicaoNoLote       Int
  statusRastreamento  StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  ativo               Boolean            @default(true)
  lote                Lote               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  movimentacoes       Movimentacao[]

  @@index([loteId])
  @@index([statusRastreamento])
}

model Movimentacao {
  id            String      @id @default(uuid())
  equipamentoId String
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String      @default("")
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  @@index([equipamentoId, dataHora])
}